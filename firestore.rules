rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Real-time live activity stream for admin tracking
    match /learnerActivity/{activityId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Rewards & UPI Cashout Redemptions
    match /redemptions/{redemptionId} {
      allow read: if true;
      allow create: if isValidId(redemptionId);
      allow update: if true;
      allow delete: if false;
    }

    // User Profile Documents - readable for learners & admin dashboard real-time tracking
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if (isOwner(userId) || !isSignedIn()) && isValidId(userId);
      allow delete: if false;

      // Subcollection: Aptitude Results
      match /aptitudeResults/{resultId} {
        allow get, list: if true;
        allow create: if isValidId(resultId);
        allow update, delete: if false;
      }

      // Subcollection: Coding Submissions
      match /codingSubmissions/{submissionId} {
        allow get, list: if true;
        allow create, update: if isValidId(submissionId);
        allow delete: if false;
      }

      // Subcollection: Skills
      match /skills/{skillId} {
        allow get, list: if true;
        allow create, update: if isValidId(skillId);
        allow delete: if isOwner(userId) && isValidId(skillId);
      }

      // Subcollection: Badges
      match /badges/{badgeId} {
        allow get, list: if true;
        allow create, update: if isValidId(badgeId);
        allow delete: if false;
      }

      // Subcollection: Roadmap
      match /roadmap/{docId} {
        allow get, list: if true;
        allow create, update: if isValidId(docId);
        allow delete: if false;
      }
    }

    // Collection group matches for global performance analytics
    match /{path=**}/aptitudeResults/{resultId} {
      allow read: if true;
    }

    match /{path=**}/codingSubmissions/{submissionId} {
      allow read: if true;
    }
  }
}
