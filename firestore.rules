rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Subcollection: Aptitude Results
      match /aptitudeResults/{resultId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(resultId) && request.resource.data.userId == userId;
        allow update, delete: if false;
      }

      // Subcollection: Coding Submissions
      match /codingSubmissions/{submissionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(submissionId) && request.resource.data.userId == userId;
        allow delete: if false;
      }

      // Subcollection: Skills
      match /skills/{skillId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(skillId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(skillId);
      }

      // Subcollection: Badges
      match /badges/{badgeId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(badgeId) && request.resource.data.userId == userId;
        allow delete: if false;
      }

      // Subcollection: Roadmap
      match /roadmap/{docId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(docId) && request.resource.data.userId == userId;
        allow delete: if false;
      }
    }
  }
}
